<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- PHYSICAL DESCRIPTION MACROS -->
    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2} 0 0" />
                <material name="black" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2} 0 0" />
            </collision>
            <xacro:cylinder_inertia m="0.05" r="${2*wheel_radius}" h="${2*wheel_width}" 
                                    xyz="0 0 0" rpy="${pi / 2} 0 0" />
        </link>
    </xacro:macro>

    <xacro:macro name="steering_link" params="prefix">
        <link name="${prefix}_steering_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_width * 0.1}" length="${wheel_radius * 0.5}" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <material name="yellow" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${0.005}" length="${0.01}" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
            </collision>
            <xacro:cylinder_inertia m="0.001" r="${2*0.005}" h="${2*0.01}" 
                                    xyz="0 0 0" rpy="0 0 0" />
        </link>
    </xacro:macro>
</robot>